# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 登录（Supabase → Project Settings → API → anon public）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 演示账号统一密码（npm run seed:users）
# DEMO_AUTH_PASSWORD=MspDemo2026!

# 是否开放遗留演示路径（/home、/preaudit、/admin、/report/:id 等）。生产请保持注释或 false
# NEXT_PUBLIC_ENABLE_LEGACY_PORTAL=true

# 教师每日 AI 初审上限
# TEACHER_AGENT_DAILY_LIMIT=30

# 智谱 GLM-5V-Turbo（报销材料 AI 审核，/audit 与 /api/agent/review）
# 在 https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys 创建并整段复制
ZHIPU_API_KEY=your-api-key
# 鉴权方式：bearer（推荐，直接 Bearer + API Key）| jwt（id.secret 时生成 JWT）
# ZHIPU_AUTH=bearer
# 可选，默认 glm-5v-turbo
# ZHIPU_MODEL=glm-5v-turbo

# 凭证暂存 TTL（秒），供运营台 AI 初审与报告页「重新识图评估」；默认 240，部署可多设 600
# MATERIAL_CACHE_TTL_SEC=600

# 提交申报时是否自动跑 Agent（生产/轻量服务器建议 false，改由 /admin「AI 初审」触发）
AUTO_AGENT_ON_SUBMIT=false

# 解析 POST /api/submissions 的 JSON 超时（毫秒），多图 base64 建议 120000
# SUBMISSION_JSON_TIMEOUT_MS=120000

# 复制本文件为 .env.local 并填入真实值，然后重启 npm run dev
