# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 智谱 GLM-5V-Turbo（报销材料 AI 审核，/audit 与 /api/agent/review）
# 在 https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys 创建并整段复制
ZHIPU_API_KEY=your-api-key
# 鉴权方式：bearer（推荐，直接 Bearer + API Key）| jwt（id.secret 时生成 JWT）
# ZHIPU_AUTH=bearer
# 可选，默认 glm-5v-turbo
# ZHIPU_MODEL=glm-5v-turbo

# 复制本文件为 .env.local 并填入真实值，然后重启 npm run dev
